---
import Layout from '../layouts/FuwariLayout.astro';

const profile = {
  name: "Your Name",
  title: "Your Profession",
  summary: "Brief summary about your experience and skills.",
  contact: {
    email: "your.email@example.com",
    location: "Your City, Country"
  },
  experience: [
    {
      role: "Job Title",
      company: "Company Name",
      period: "2020 - Present",
      description: "Describe your responsibilities and achievements."
    }
    // ...add more experience...
  ],
  education: [
    {
      degree: "Degree Name",
      school: "School Name",
      period: "2015 - 2019"
    }
    // ...add more education...
  ]
};
---
<Layout>
  <section>
    <h1>{profile.name}</h1>
    <h2>{profile.title}</h2>
    <p>{profile.summary}</p>
    <ul>
      <li>Email: {profile.contact.email}</li>
      <li>Location: {profile.contact.location}</li>
    </ul>
  </section>
  <section>
    <h3>Experience</h3>
    <ul>
      {profile.experience.map(exp => (
        <li>
          <strong>{exp.role}</strong> at {exp.company} ({exp.period})<br />
          <span>{exp.description}</span>
        </li>
      ))}
    </ul>
  </section>
  <section>
    <h3>Education</h3>
    <ul>
      {profile.education.map(edu => (
        <li>
          <strong>{edu.degree}</strong>, {edu.school} ({edu.period})
        </li>
      ))}
    </ul>
  </section>
</Layout>
